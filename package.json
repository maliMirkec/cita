  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/maliMirkec/cita/issues"
  },
  "homepage": "https://github.com/maliMirkec/cita#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "staticrafter": "^0.1.3"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.11.2",
    "autoprefixer": "^10.6.1",
    "clean-css": "^5.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{css,js,cjs,mjs,ts,tsx,md,liquid}": "prettier --write"
  }
