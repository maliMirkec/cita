  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "rm -rf _site && npx @11ty/eleventy --serve",
    "fresh": "rm -rf _site .cache && npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "format": "prettier --write \"**/*.{css,js,cjs,mjs,ts,tsx,md,liquid}\"",
    "format:check": "prettier --check \"**/*.{css,js,cjs,mjs,ts,tsx,md,liquid}\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maliMirkec/cita.git"
  },
  "keywords": [],
